# Copy to .env and fill in values. Never commit .env.

# Logging
ATLAS_LOG_LEVEL=INFO
ATLAS_LOG_DIR=logs

# Slack (Phase 2+)
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-token
SLACK_CHANNEL_ID=C0000000000
ATLAS_SLACK_ENABLED=true
SLACK_ALLOWED_USER_IDS=U0000000000
SLACK_ALLOWED_CHANNEL_IDS=C0000000000
SLACK_LOG_TAIL_LINES=40
SLACK_STOP_KILL_SESSION=false

# Browser (Playwright)
ATLAS_BROWSER_HEADLESS=true
ATLAS_BROWSER_MAX_SEC=120
ATLAS_BROWSER_TIMEOUT_MS=30000
ATLAS_BROWSER_CAPTURE_SUCCESS=true
ATLAS_BROWSER_CAPTURE_FAILURE=true

# Adaptive recovery
ATLAS_MAX_RECOVERY_ATTEMPTS=5
ATLAS_MAX_SAME_STRATEGY_FAILURES=2
ATLAS_INVESTIGATE_AFTER_FAILURES=2
ATLAS_ESCALATE_AFTER_ATTEMPTS=6

# Git safety
ATLAS_GIT_ENABLED=true
ATLAS_GIT_AUTO_ISOLATE=true
ATLAS_GIT_AUTO_CHECKPOINT=true
ATLAS_GIT_MAX_ROLLBACKS=3
ATLAS_GIT_MAX_DEP_CHANGES=5
ATLAS_HEALTH_REGRESSION_THRESHOLD=15

# Operational memory
ATLAS_MEMORY_ENABLED=true
ATLAS_MEMORY_INJECT_CONTEXT=true
ATLAS_MEMORY_PRUNE_DAYS=90

# Paths
ATLAS_PROJECTS_DIR=projects
ATLAS_CONFIG_PATH=configs/default.yaml

# Orchestrator
ATLAS_POLL_INTERVAL_SEC=5
ATLAS_MAX_CONCURRENT_TASKS=3

# Claude Code (tmux)
ATLAS_CLAUDE_COMMAND=claude
ATLAS_CLAUDE_MAX_SEC=3600
ATLAS_CLAUDE_POLL_SEC=2
ATLAS_CLAUDE_LAUNCH_WAIT_SEC=15
ATLAS_CLAUDE_IDLE_POLLS=3
ATLAS_CLAUDE_CAPTURE_LINES=200
ATLAS_CLAUDE_KILL_SESSION=false
